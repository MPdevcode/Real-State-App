@if (TempData["Success"] is string success)
{
    <div class="notice notice-success" role="status"><strong>Operación completada</strong><p>@success</p></div>
}
@if (TempData["Error"] is string error)
{
    <div class="notice notice-error" role="alert"><strong>No se pudo completar la operación</strong><p>@error</p></div>
}
